#!/usr/bin/python3
from http.server import HTTPServer, BaseHTTPRequestHandler
from collections import defaultdict, deque
from pathlib import Path
import time
import math

LIMIT = 5
WINDOW = 10
HITS = defaultdict(deque)
LOG = Path("/home/ubuntu/lab17/events.log")

class Handler(BaseHTTPRequestHandler):
    def reply(self, status, body, remaining=0, retry=None):
        payload = (body + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("X-RateLimit-Limit", str(LIMIT))
        self.send_header("X-RateLimit-Remaining", str(remaining))
        if retry is not None:
            self.send_header("Retry-After", str(retry))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        if self.path == "/health":
            self.reply(200, "LAB17_SERVER_HEALTHY")
            return

        if self.path != "/resource":
            self.reply(404, "NOT_FOUND")
            return

        ip = self.client_address[0]
        now = time.monotonic()
        entries = HITS[ip]

        while entries and now - entries[0] >= WINDOW:
            entries.popleft()

        if len(entries) < LIMIT:
            entries.append(now)
            status = 200
            remaining = LIMIT - len(entries)
            retry = None
            body = "LAB17_REQUEST_OK"
            event = "REQUEST_ALLOWED"
        else:
            status = 429
            remaining = 0
            retry = max(1, math.ceil(WINDOW - (now - entries[0])))
            body = "LAB17_RATE_LIMIT_EXCEEDED"
            event = "RATE_LIMIT_BLOCK"

        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(
                f"LAB17_EVENT={event} src_ip={ip} "
                f"status={status} limit={LIMIT} window={WINDOW}\n"
            )

        self.reply(status, body, remaining, retry)

    def log_message(self, *args):
        pass

HTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
