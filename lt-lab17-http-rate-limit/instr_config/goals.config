http_server_healthy = boolean : (_health)
#DOC http_server_healthy : HTTP server responds to health checks.
normal_request_allowed = boolean : (_normal)
#DOC normal_request_allowed : Normal HTTP requests return 200.
rate_limit_headers_verified = boolean : (_headers)
#DOC rate_limit_headers_verified : Rate limit headers are verified.
burst_rate_limited = boolean : (_burst and _server)
#DOC burst_rate_limited : Excessive requests receive HTTP 429.
retry_after_verified = boolean : (_retry)
#DOC retry_after_verified : HTTP 429 includes Retry-After.
rate_limit_recovery_verified = boolean : (_recovery)
#DOC rate_limit_recovery_verified : Requests succeed after the limit window expires.
server_abuse_logged = boolean : (_server)
#DOC server_abuse_logged : Server records rate-limit violations.
